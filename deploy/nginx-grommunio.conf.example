# Example nginx server block for serving grommunio Next on its own host name.
# Copy to /etc/nginx/conf.d/ and adjust server_name, certificates and the
# document root. The bundle (output of `yarn build`) and a config.json go
# into the document root.

server {
    server_name next.example.com;
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    ssl_certificate     /etc/grommunio-common/ssl/server-bundle.pem;
    ssl_certificate_key /etc/grommunio-common/ssl/server.key;

    root /usr/share/grommunio-next;
    index index.html;
    server_tokens off;

    # No framing by other sites (clickjacking). 'self' keeps MSAL's hidden
    # iframe token renewal working, which loads the app's redirect URI.
    # A location with its own add_header must repeat these lines.
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Must be revalidated, otherwise a cached copy points at deleted chunks after an update
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Runtime configuration must never be cached by the browser
    location = /config.json {
        add_header Cache-Control "no-cache, no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Hashed assets can be cached forever
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Client side routing: unknown paths fall back to index.html (served by the block above)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
